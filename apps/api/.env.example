# 광고 설정 예시. 기존 DB·인증·AI 환경 변수는 별도로 유지한다.
# 로컬은 설정을 생략해도 test이며, NODE_ENV=production에서는 테스트 보상을 거절한다.
ADMOB_REWARD_MODE=test

# 실제 광고로 전환할 때 production과 iOS 보상형 광고 단위 ID(/ 포함)를 설정한다.
# ADMOB_REWARD_MODE=production
# ADMOB_REWARDED_AD_UNIT_ID=ca-app-pub-XXXXXXXXXXXXXXXX/YYYYYYYYYY

# AdMob 광고 단위의 서버 측 확인(SSV)에 다음 주소를 등록한다.
# https://공개된-API-주소/ads/admob/reward
# 보상 수량은 1로 설정한다. 로컬 주소는 Google에서 접속할 수 없어 실제 SSV에는 공개 주소가 필요하다.
