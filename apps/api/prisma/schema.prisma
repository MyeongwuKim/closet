generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum AuthProvider {
  apple
  google
  kakao
}

enum PreferredFit {
  wide
  regular
  skinny
}

enum Gender {
  male
  female
}

enum BodyBuild {
  slim
  average
  athletic
  broad
}

enum Season {
  spring
  summer
  autumn
  winter
}

enum OutfitStyle {
  minimal
  casual
  street
  classic
  vintage
  sporty
}

enum ClothingCategory {
  top
  bottom
  outer
  midlayer
  dress
  shoes
  accessory
  other
}

enum ClassificationStatus {
  pending
  classified
  failed
}

enum ColorMode {
  solid
  patterned
  multicolor
}

enum ImageAssetKind {
  wardrobeOriginal
  wardrobeCutout
  outfitGenerated
}

enum ImageUploadStatus {
  pending
  ready
  failed
}

enum ImageAssetRetention {
  temporary
  permanent
  deleting
}

enum OutfitSource {
  manual
  ai
}

enum GenerationStatus {
  queued
  processing
  completed
  failed
}

enum AiTaskStatus {
  queued
  processing
  completed
  failed
  interrupted
}

enum PushPlatform {
  ios
  android
}

model User {
  id              String                @id @default(auto()) @map("_id") @db.ObjectId
  displayName     String?
  email           String?
  isTemporary     Boolean               @default(true)
  lastLoginAt     DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  oauthAccounts   OAuthAccount[]
  testAccount     TestAccount?
  sessions        UserSession[]
  styleProfile    StyleProfile?
  settings        UserSettings?
  preferredStyles UserStylePreference[]
  wardrobeItems   WardrobeItem[]
  imageAssets     ImageAsset[]
  outfits         Outfit[]
  plannerWeeks    PlannerWeek[]
  generations     OutfitGeneration[]
  pushDevices     PushDevice[]
}

model PushDevice {
  id               String       @id @default(auto()) @map("_id") @db.ObjectId
  userId           String       @db.ObjectId
  sessionTokenHash String
  expoPushToken    String       @unique
  platform         PushPlatform
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  user             User         @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([sessionTokenHash])
}

model TestAccount {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  userId       String   @unique @db.ObjectId
  loginId      String   @unique
  passwordHash String
  passwordSalt String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id])
}

model UserSession {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  userId     String   @db.ObjectId
  tokenHash  String   @unique
  expiresAt  DateTime
  lastUsedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([expiresAt])
}

// 임시 로그인 사용자는 User만 만들고, 네이티브 OAuth 도입 시 이 계정을 연결한다.
model OAuthAccount {
  id                String       @id @default(auto()) @map("_id") @db.ObjectId
  userId            String       @db.ObjectId
  provider          AuthProvider
  providerAccountId String
  providerEmail     String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  user              User         @relation(fields: [userId], references: [id])

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model StyleProfile {
  id                   String       @id @default(auto()) @map("_id") @db.ObjectId
  userId               String       @unique @db.ObjectId
  gender               Gender?
  bodyBuild            BodyBuild?
  heightCm             Float?
  weightKg             Float?
  chestCircumferenceCm Float?
  waistCircumferenceCm Float?
  hipCircumferenceCm   Float?
  shoulderWidthCm      Float?
  inseamCm             Float?
  preferredFit         PreferredFit @default(regular)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  user                 User         @relation(fields: [userId], references: [id])
}

model UserSettings {
  id                         String   @id @default(auto()) @map("_id") @db.ObjectId
  userId                     String   @unique @db.ObjectId
  enabled                    Boolean  @default(false)
  intervalDays               Int      @default(7)
  combinationReminderEnabled Boolean  @default(true)
  itemReminderEnabled        Boolean  @default(true)
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt
  user                       User     @relation(fields: [userId], references: [id])
}

model UserStylePreference {
  id        String      @id @default(auto()) @map("_id") @db.ObjectId
  userId    String      @db.ObjectId
  style     OutfitStyle
  createdAt DateTime    @default(now())
  user      User        @relation(fields: [userId], references: [id])

  @@unique([userId, style])
  @@index([userId])
}

// 실제 이미지는 Cloudflare Images에 저장하고 cloudflareImageId만 DB에 보관한다.
model ImageAsset {
  id                    String              @id @default(auto()) @map("_id") @db.ObjectId
  userId                String              @db.ObjectId
  cloudflareImageId     String              @unique
  kind                  ImageAssetKind
  uploadStatus          ImageUploadStatus   @default(pending)
  retention             ImageAssetRetention @default(permanent)
  expiresAt             DateTime?
  deliveryVariant       String?
  deliveryUrl           String?
  originalFilename      String?
  storageFilename       String?
  mimeType              String?
  width                 Int?
  height                Int?
  metadata              Json?
  // 이미지 저장 직후 서버가 중단돼도 생성 작업의 결과를 다시 찾는다.
  aiPreviewJobId        String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  user                  User                @relation(fields: [userId], references: [id])
  wardrobeDisplayItems  WardrobeItem[]      @relation("WardrobeDisplayImage")
  wardrobeOriginalItems WardrobeItem[]      @relation("WardrobeOriginalImage")
  outfitGenerations     OutfitGeneration[]

  @@index([userId, kind])
  @@index([kind, retention, expiresAt])
  @@index([userId, aiPreviewJobId])
}

// 입력 원문은 저장하지 않는다. 사용자·기능·입력 해시로 동시 작업과 짧은 결과 캐시를 공유한다.
model AiExecution {
  id           String       @id @map("_id")
  userId       String
  kind         String
  status       AiTaskStatus
  leaseToken   String
  leaseUntil   DateTime
  resultText   String?
  errorCode    String?
  errorMessage String?
  cacheUntil   DateTime
  expiresAt    DateTime
  updatedAt    DateTime     @updatedAt

  @@index([expiresAt])
}

// UTC 분·날짜별 횟수를 트랜잭션 안에서 갱신해 여러 API 서버가 같은 한도를 사용한다.
model AiQuota {
  id          String   @id @map("_id")
  minuteStart DateTime
  minuteCount Int
  dayStart    DateTime
  dayCount    Int
  expiresAt   DateTime

  @@index([expiresAt])
}

// global:0…과 user:<해시>:0… 슬롯을 함께 점유해 전체·사용자별 동시 실행을 제한한다.
model AiLease {
  id         String   @id @map("_id")
  token      String
  leaseUntil DateTime

  @@index([leaseUntil])
}

// 앱의 HTTP 연결과 독립적으로 처리하는 이미지 생성 요청. 결과 바이트 대신 이미지 자산 ID를 보관한다.
model AiPreviewJob {
  id               String       @id @map("_id")
  userId           String       @db.ObjectId
  requestKeys      String[]
  inputKey         String
  fingerprint      String
  selectedItemIds  String[]
  style            String?
  status           AiTaskStatus @default(queued)
  leaseToken       String?
  leaseUntil       DateTime?
  requestStartedAt DateTime?
  attempts         Int          @default(0)
  imageAssetId     String?       @db.ObjectId
  model            String?
  errorCode        String?
  errorMessage     String?
  acknowledgedAt   DateTime?
  // 예약 사용권. creditSource=wallet이면 creditDayId는 사용자 지갑 키, free/reward이면 이전 날짜 키다. 필드가 없는 이전 작업은 null이다.
  creditDayId      String?
  creditSource     String?
  creditState      String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  expiresAt        DateTime

  @@index([userId, status, createdAt])
  @@index([requestKeys])
  @@index([status, leaseUntil])
  @@index([expiresAt])
}

// 시간 충전되는 AI 사용권. 가득 차면 refillStartedAt을 null로 저장해 충전을 멈춘다.
model AiCreditWallet {
  userId          String   @id @map("_id") @db.ObjectId
  balance         Int      @default(5)
  refillStartedAt DateTime?
  updatedAt       DateTime @updatedAt
}

// 한국 시간 날짜·이용권 종류별 잔액. 종류는 해시 ID로 구분한다. used에는 진행 중 예약도 포함하며 실패 시 같은 날짜에서 돌려준다.
model PreviewCreditDay {
  id            String   @id @map("_id")
  userId        String   @db.ObjectId
  day           String
  freeUsed      Int      @default(0)
  rewardGranted Int      @default(0)
  rewardUsed    Int      @default(0)
  expiresAt     DateTime
  updatedAt     DateTime @updatedAt

  @@index([expiresAt])
}

// 광고 한 번에 대응하는 서버 발급 번호. 실제 계정 ID 대신 이 번호만 광고 SDK에 전달한다.
model PreviewRewardSession {
  id            String   @id @map("_id")
  userId        String   @db.ObjectId
  // 광고를 요청한 기능. 이전 세션은 null이며 보상은 종류와 관계없이 공통 지갑에 지급한다.
  creditKind    String?
  mode          String
  adUnitId      String
  status        String   @default("pending")
  watchedAt     DateTime?
  rewardedAt    DateTime?
  createdAt     DateTime @default(now())
  validUntil    DateTime
  expiresAt     DateTime

  @@index([userId, status, validUntil])
  @@index([expiresAt])
}

// Google 거래 번호를 _id로 보관해 콜백 재전송·다른 세션을 이용한 중복 지급을 막는다.
model PreviewRewardReceipt {
  id        String   @id @map("_id")
  sessionId String
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([expiresAt])
}

model WardrobeItem {
  id                       String               @id @default(auto()) @map("_id") @db.ObjectId
  userId                   String               @db.ObjectId
  name                     String
  brandName                String?
  displayImageAssetId      String?              @db.ObjectId
  originalImageAssetId     String?              @db.ObjectId
  category                 ClothingCategory?
  additionalCategories     ClothingCategory[]   @default([])
  subcategory              String?
  colorName                String?
  colorDetailName          String?
  colorHex                 String?
  colorMode                ColorMode?
  fashionAttributes        Json?
  seasons                  Season[]             @default([])
  tags                     String[]             @default([])
  sizeLabel                String?
  shoulderWidthCm          Float?
  chestWidthCm             Float?
  sleeveLengthCm           Float?
  totalLengthCm            Float?
  waistWidthCm             Float?
  hipWidthCm               Float?
  inseamCm                 Float?
  thighWidthCm             Float?
  riseCm                   Float?
  hemWidthCm               Float?
  classificationStatus     ClassificationStatus @default(pending)
  classificationConfidence Float?
  classificationModel      String?
  classificationCandidates Json?
  wearCount                Int                  @default(0)
  lastWornAt               DateTime?
  archivedAt               DateTime?
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt
  user                     User                 @relation(fields: [userId], references: [id])
  displayImageAsset        ImageAsset?          @relation("WardrobeDisplayImage", fields: [displayImageAssetId], references: [id])
  originalImageAsset       ImageAsset?          @relation("WardrobeOriginalImage", fields: [originalImageAssetId], references: [id])
  outfitItems              OutfitItem[]

  @@index([userId, category, subcategory])
  @@index([userId, additionalCategories])
  @@index([userId, classificationStatus])
}

model Outfit {
  id          String             @id @default(auto()) @map("_id") @db.ObjectId
  userId      String             @db.ObjectId
  name        String
  style       String
  seasons     Season[]           @default([])
  source      OutfitSource       @default(manual)
  note        String?
  plannerOnly Boolean?           @default(false)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  user        User               @relation(fields: [userId], references: [id])
  items       OutfitItem[]
  planEntries PlannerEntry[]
  generations OutfitGeneration[]

  @@index([userId, style, createdAt])
}

model OutfitItem {
  id             String           @id @default(auto()) @map("_id") @db.ObjectId
  outfitId       String           @db.ObjectId
  wardrobeItemId String           @db.ObjectId
  slot           ClothingCategory
  layerOrder     Int              @default(0)
  outfit         Outfit           @relation(fields: [outfitId], references: [id])
  wardrobeItem   WardrobeItem     @relation(fields: [wardrobeItemId], references: [id])

  @@unique([outfitId, wardrobeItemId])
  @@index([wardrobeItemId])
}

model PlannerWeek {
  id           String         @id @default(auto()) @map("_id") @db.ObjectId
  userId       String         @db.ObjectId
  weekStartsOn DateTime
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  user         User           @relation(fields: [userId], references: [id])
  entries      PlannerEntry[]

  @@unique([userId, weekStartsOn])
  @@index([userId])
}

model PlannerEntry {
  id             String      @id @default(auto()) @map("_id") @db.ObjectId
  plannerWeekId  String      @db.ObjectId
  outfitId       String?     @db.ObjectId
  date           DateTime
  title          String?
  occasion       String?
  weatherSummary String?
  temperatureC   Float?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  plannerWeek    PlannerWeek @relation(fields: [plannerWeekId], references: [id])
  outfit         Outfit?     @relation(fields: [outfitId], references: [id])

  @@unique([plannerWeekId, date])
  @@index([outfitId])
}

// 한 코디에서 여러 번 생성할 수 있으므로 결과와 실행 이력을 분리한다.
model OutfitGeneration {
  id           String           @id @default(auto()) @map("_id") @db.ObjectId
  userId       String           @db.ObjectId
  outfitId     String           @db.ObjectId
  imageAssetId String?          @db.ObjectId
  status       GenerationStatus @default(queued)
  model        String?
  prompt       String?
  errorMessage String?
  requestedAt  DateTime         @default(now())
  completedAt  DateTime?
  user         User             @relation(fields: [userId], references: [id])
  outfit       Outfit           @relation(fields: [outfitId], references: [id])
  imageAsset   ImageAsset?      @relation(fields: [imageAssetId], references: [id])

  @@index([userId, requestedAt])
  @@index([outfitId, status])
}

// 같은 날 같은 추천 입력은 예약·결과를 재사용한다. 만료된 예약은 다음 접근에서 반환한다.
model RecommendationCreditUse {
  id           String   @id @map("_id")
  userId       String   @db.ObjectId
  creditDayId  String
  creditSource String
  state        String
  token        String
  leaseUntil   DateTime
  resultText   String?
  expiresAt    DateTime

  @@index([userId, state, leaseUntil])
  @@index([expiresAt])
}
