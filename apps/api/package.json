    "@huggingface/transformers": "^4.2.0",
    "@prisma/client": "6.19.1",
    "fastify": "^5.11.3",
    "graphql": "^16.11.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "prisma": "6.19.1",
    "tsx": "^4.23.12",
    "typescript": "~6.0.2"
  }
