{
  "cli": {
    "version": ">= 18.11.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": false,
      "distribution": "internal",
      "env": {
        "WEAROOM_APP_ENV": "development"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "WEAROOM_APP_ENV": "development"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "WEAROOM_APP_ENV": "production"
      }
    },
    "local": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "WEAROOM_APP_ENV": "local"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
