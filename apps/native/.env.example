# 로컬 iOS 시뮬레이터. 실제 기기는 같은 네트워크에 있는 Mac의 IP 주소로 바꾼다.
EXPO_PUBLIC_API_URL=http://localhost:4000

# 비워두면 local/development 빌드는 Google 테스트 앱 ID를 자동 사용한다.
# 실제 광고 전환 시 AdMob에서 만든 iOS 앱 ID(~ 포함)를 입력하고 앱을 다시 빌드한다.
# 운영 빌드는 이 값이 없으면 광고 보상 기능을 비활성화한다.
# EXPO_PUBLIC_ADMOB_IOS_APP_ID=ca-app-pub-XXXXXXXXXXXXXXXX~YYYYYYYYYY
