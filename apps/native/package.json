{
  "name": "@closet/native",
  "private": true,
  "version": "0.1.0",
  "main": "expo/AppEntry.js",
  "scripts": {
    "bundle:web": "node scripts/sync-web-build.mjs",
    "bundle:web:reuse": "node scripts/sync-web-build.mjs --skip-build",
    "start": "pnpm run bundle:web && expo start --dev-client",
    "android": "pnpm run bundle:web && expo run:android",
    "ios": "pnpm run ios:local",
    "ios:local": "pnpm run bundle:web && expo run:ios",
    "ios:device": "pnpm run bundle:web && expo run:ios --device",
    "web": "expo start --web",
    "typecheck": "pnpm run bundle:web && tsc --noEmit"
  },
  "dependencies": {
    "@closet/types": "workspace:*",
    "expo": "^57.0.11",
    "expo-application": "~57.0.2",
    "expo-dev-client": "~57.0.13",
    "expo-image-picker": "~57.0.12",
    "expo-location": "~57.0.12",
    "expo-notifications": "~57.0.13",
    "expo-secure-store": "~57.0.1",
    "expo-status-bar": "^57.0.1",
    "react": "^19.2.3",
    "react-native": "^0.86.2",
    "react-native-webview": "13.16.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "typescript": "~6.0.2"
  }
}
