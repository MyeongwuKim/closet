{
  "name": "@closet/native",
  "private": true,
  "version": "0.1.0",
  "main": "index.ts",
  "scripts": {
    "bundle:web": "node scripts/sync-web-build.mjs",
    "bundle:web:reuse": "node scripts/sync-web-build.mjs --skip-build",
    "web:sync": "pnpm run bundle:web && node scripts/reload-app.mjs",
    "test:web-sync": "node --test scripts/reload-app.test.mjs scripts/native-document.test.mjs",
    "test:camera-bridge": "node --test scripts/camera-bridge.test.mjs",
    "test:location-bridge": "node --test scripts/location-bridge.test.mjs",
    "test:initial-permission": "node --test scripts/initial-permission.test.mjs",
    "start": "pnpm run bundle:web && expo start --dev-client",
    "android": "pnpm run bundle:web && expo run:android",
    "ios": "pnpm run ios:local",
    "ios:local": "pnpm run bundle:web && expo run:ios",
    "ios:device": "pnpm run bundle:web && expo run:ios --device",
    "web": "expo start --web",
    "typecheck": "pnpm run bundle:web && tsc --noEmit"
  },
  "dependencies": {
    "@closet/types": "workspace:*",
    "expo": "~54.0.37",
    "expo-application": "~7.0.8",
    "expo-dev-client": "~6.0.21",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-location": "~19.0.8",
    "expo-notifications": "~0.32.17",
    "expo-secure-store": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-webview": "13.15.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "typescript": "~5.9.2",
    "ws": "^8.21.3"
  }
}
