{
  "name": "closet",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.20.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @closet/web --filter @closet/api dev",
    "api:dev": "pnpm --filter @closet/api dev",
    "api:cleanup:outfit-previews": "pnpm --filter @closet/api cleanup:outfit-previews",
    "api:cleanup:cloudflare-orphans": "pnpm --filter @closet/api cleanup:cloudflare-orphans",
    "web:dev": "pnpm --filter @closet/web dev",
    "native:dev": "pnpm --filter @closet/native start",
    "native:bundle": "pnpm --filter @closet/native bundle:web",
    "native:web:sync": "pnpm --filter @closet/native web:sync",
    "native:ios:dev": "pnpm --filter @closet/native ios:dev",
    "native:ios:prod": "pnpm --filter @closet/native ios:prod",
    "native:ios:local": "pnpm --filter @closet/native ios:local",
    "native:ios:device": "pnpm --filter @closet/native ios:device",
    "native:android:dev": "pnpm --filter @closet/native android",
    "build": "pnpm -r --if-present build",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "typecheck:e2e": "tsc -p tsconfig.e2e.json && tsc -p tsconfig.ai-tests.json",
    "typecheck:ai": "tsc -p tsconfig.ai-tests.json",
    "test:unit:api": "pnpm --filter @closet/api exec node ../../scripts/run-unit-tests.mjs src",
    "test:unit:web": "pnpm --filter @closet/api exec sh -c 'TSX_TSCONFIG_PATH=../../apps/web/tsconfig.app.json node ../../scripts/run-unit-tests.mjs ../../apps/web/tests'",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:ai:api": "pnpm typecheck:ai && playwright test --config playwright.ai.config.ts",
    "test:ai:api:report": "playwright show-report .playwright-mcp/ai-api-report",
    "test:ai:rules": "pnpm --filter @closet/api test:colors",
    "ios:dev": "pnpm --filter @closet/native ios:dev",
    "ios:prod": "pnpm --filter @closet/native ios:prod",
    "ios:local": "pnpm --filter @closet/native ios:local",
    "ios:device": "pnpm --filter @closet/native ios:device"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^24.13.3",
    "typescript": "~6.0.3"
  }
}
